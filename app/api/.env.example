# Reference only: ASP.NET Core does not load .env files, and the API never reads this
# file or .env.local. Set each value with dotnet user-secrets locally (the name with
# ":" in place of "__", for example "Auth:Issuer") or as an environment variable on
# the host, exactly as named here. See docs/DATABASE.md and docs/DEPLOYMENT.md.

# Set by the host, not by hand locally: render.yaml sets Production, and
# `npm run dev:api` passes Development. The Dockerfile listens on port 8080.
# ASPNETCORE_ENVIRONMENT="Production"
# ASPNETCORE_HTTP_PORTS="8080"

# PostgreSQL (Supabase). On Windows, add
# ;Root Certificate=<absolute path to app/api/certs/prod-ca-2021.crt>
# so the server certificate can be verified (docs/DATABASE.md).
ConnectionStrings__Database="Host=YOUR_DATABASE_HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SSL Mode=VerifyFull"

# Origin of the web app that issues sign-in tokens: the same value as the web app's
# BETTER_AUTH_URL. An exact origin, HTTPS, or HTTP on loopback. Without it every
# signed-in request fails.
Auth__Issuer="http://localhost:3000"

# GitHub App used to read repositories, issues, pull requests, commits, checks, and
# releases (ADR-032, docs/DEPLOYMENT.md). Without AppId and PrivateKey the repository
# and evidence features answer "GitHub is not set up".
GitHub__AppId=""
# The app's private key in PEM form (RSA). Multiline, or one line with literal \n.
# Locally: dotnet user-secrets set "GitHub:PrivateKey" (Get-Content "<path>.pem" -Raw) --project app/api
GitHub__PrivateKey=""
# The app's public name, the last part of https://github.com/apps/<slug>. Used for the install link.
GitHub__AppSlug=""
# Tests only: a stand-in for https://api.github.com. Leave unset.
# GitHub__ApiBaseUrl=""

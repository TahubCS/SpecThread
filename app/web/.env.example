# Better Auth Configuration
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Authentication Database Connection (Supabase Session Pooler or Direct)
# Used only for Better Auth tables (user, session, account, verification, jwks, rateLimit)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@[host]:5432/postgres"
# Read only when DATABASE_URL is empty. Leave unset unless the host reserves DATABASE_URL.
# BETTER_AUTH_DATABASE_URL=""
# Full PEM contents of the Supabase CA certificate, multiline or with literal \n.
# Leave empty only when the server certificate is trusted by Node's default CAs.
DATABASE_CA_CERT=""
# SpecThread API origin for server-side calls (docs/API.md). HTTPS, or HTTP on loopback.
# `npm run dev:api` listens on http://127.0.0.1:5100. The API's Auth:Issuer must be
# this app's BETTER_AUTH_URL (app/api/.env.example).
SPECTHREAD_API_URL="http://127.0.0.1:5100"

# Optional dashboard integration; disabled unless an explicit key is configured.
BETTER_AUTH_API_KEY=""

# GitHub OAuth credentials (GitHub sign-in is disabled when both are empty;
# setting only one fails at startup)
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# Use the client ID and secret of the SpecThread GitHub App, the same app the API is
# configured with, so a signed-in user's token can list the repositories the app is
# installed on (docs/DEPLOYMENT.md).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth client (Google sign-in is disabled unless both are set)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email for verification and password reset (ADR-016)
# resend (default) needs RESEND_API_KEY and EMAIL_FROM on a verified domain.
# log prints links to the server console; allowed only for a loopback BETTER_AUTH_URL.
EMAIL_DELIVERY="resend"
# Use a Resend key with sending access only, limited to the sending domain.
RESEND_API_KEY=""
EMAIL_FROM="SpecThread <no-reply@your-verified-domain>"

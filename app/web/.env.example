# Better Auth Configuration
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Database Connection (Supabase Session Pooler or Direct)
# Used only for Better Auth authentication tables (user, session, account, verification, jwks)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@[host]:5432/postgres"
# Full PEM contents of the Supabase CA certificate, multiline or with literal \n.
# Leave empty only when the server certificate is trusted by Node's default CAs.
DATABASE_CA_CERT=""
# Optional dashboard integration; disabled unless an explicit key is configured.
BETTER_AUTH_API_KEY=""

# GitHub OAuth Application Credentials
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Google OAuth client (Google sign-in is disabled unless both are set)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email for verification and password reset (ADR-016)
# resend (default) needs RESEND_API_KEY and EMAIL_FROM on a verified domain.
# log prints links to the server console; allowed only for a loopback BETTER_AUTH_URL.
EMAIL_DELIVERY="resend"
RESEND_API_KEY=""
EMAIL_FROM="SpecThread <no-reply@your-verified-domain>"

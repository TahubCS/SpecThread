{
  "name": "specthread",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/web"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "dev": "npm run dev --workspace @specthread/web",
    "build": "npm run build --workspace @specthread/web",
    "start": "npm run start --workspace @specthread/web",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspace @specthread/web && tsc --noEmit",
    "dev:api": "dotnet run --project app/api --no-launch-profile -- --urls http://127.0.0.1:5100 --environment Development",
    "build:api": "dotnet build app/api --configuration Release",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "schema:generate": "node scripts/generate-initial-schema.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "better-auth": "^1.7.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9"
  }
}
